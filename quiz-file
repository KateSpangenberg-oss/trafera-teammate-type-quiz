      Anchor: "https://connect.trafera.com/hubfs/For%20Web/teammate-type-anchor.png"
    };

    const HUBSPOT_PORTAL_ID = "7667743";
    const HUBSPOT_REGION = "na1";
    const HUBSPOT_FORM_IDS = {
      Trailblazer: "21d26ef1-1e14-41cf-98bf-01f0acdef6ee",
      Driver: "03296c84-3b80-4818-a90d-e6a90ada49df",
      Connector: "99016ea2-fa17-4735-a1c4-789b1c767b18",
      Anchor: "1764fe9a-215c-4a9c-b501-472b4c24a2f2"
    };

    function renderHubSpotForm(winningType) {
      const container = document.getElementById('hubspot-form-container');
      if (!container) return;
      container.innerHTML = '';
      const formId = HUBSPOT_FORM_IDS[winningType];

      if (window.hbspt && window.hbspt.forms && window.hbspt.forms.create) {
        window.hbspt.forms.create({
          region: HUBSPOT_REGION,
          portalId: HUBSPOT_PORTAL_ID,
          formId: formId,
          target: "#hubspot-form-container"
        });
      }
    }

    const quizQuestions = [
      {
        question: "How do you naturally contribute to a new project?",
        options: [
          { text: "You pitch the big, ambitious idea nobody else thought of", type: "trailblazer" },
          { text: "You turn the idea into an actual plan and start moving", type: "driver" },
          { text: "You get everyone excited and on board", type: "cheerleader" },
          { text: "You make sure the basics are covered so nothing falls through the cracks", type: "anchor" },
          { text: "You make sure it's the right plan, not just the fast one", type: "compass" }
        ]
      },
      {
        question: "A teammate is stuck on something tricky. How do you show up?",
        options: [
          { text: "You suggest a totally different way to approach it", type: "trailblazer" },
          { text: "You jump in and help push it across the finish line", type: "driver" },
          { text: "You check in on how they're feeling, not just the problem", type: "cheerleader" },
          { text: "You quietly take something off their plate so they can focus", type: "anchor" },
          { text: "You give them your honest, straightforward take", type: "compass" }
        ]
      },
      {
        question: "Your team just hit a big win. What are you doing?",
        options: [
          { text: "Already dreaming up the next big goal", type: "trailblazer" },
          { text: "Making sure the momentum carries into what's next", type: "driver" },
          { text: "Leading the celebration so everyone feels it", type: "cheerleader" },
          { text: "Documenting what worked so it can happen again", type: "anchor" },
          { text: "Making sure credit goes to the right people", type: "compass" }
        ]
      },
      {
        question: "How do you prefer to receive feedback?",
        options: [
          { text: "Give me the big picture — what should we be aiming for?", type: "trailblazer" },
          { text: "Just tell me what to fix, I'll get moving", type: "driver" },
          { text: "I like a real conversation about it, not just a written note", type: "cheerleader" },
          { text: "Straightforward and consistent — no surprises", type: "anchor" },
          { text: "I want it to be honest, even if it's hard to hear", type: "compass" }
        ]
      },
      {
        question: "What's most satisfying at the end of a workday?",
        options: [
          { text: "Having pushed an idea further than it was yesterday", type: "trailblazer" },
          { text: "Crossing things off the list — visible progress", type: "driver" },
          { text: "A good conversation or moment with a teammate", type: "cheerleader" },
          { text: "Knowing you followed through on what you said you'd do", type: "anchor" },
          { text: "Knowing you did things the right way, not just the easy way", type: "compass" }
        ]
      }
    ];

    const resultsCatalog = {
      Trailblazer: {
        title: "The Trailblazer",
        values: "Growth",
        description: "You are always helping your team shoot for the moon with big ideas and ambitious goals. The energy you put toward forging new paths, developing new processes, and thinking outside the box is what keeps Trafera moving forward toward a bright future."
      },
      Driver: {
        title: "The Driver",
        values: "Action",
        description: "Some people have the ideas, but you make them happen. You excel at taking an idea and running with it, with a special skill for keeping projects moving ahead. You're all about execution, efficiency, and effectiveness, and the people on your team count on you for the momentum you bring to each endeavor."
      },
      Connector: {
        title: "The Connector",
        values: "Connection",
        description: "Everyone on your team knows if they need a little encouragement, a listening ear, or just a good conversation, you're their go-to. You excel at bringing people together with your magnetism and enthusiasm, bringing a positive and optimistic energy that helps rally those around you."
      },
      Anchor: {
        title: "The Anchor",
        values: "Dependability & Integrity",
        description: "What some might call a \"Steady Eddy,\" you're the type of teammate that everyone knows they can count on. Whether through your consistency, your willingness to lend a hand, or your commitment to doing things the right way, your team knows they can rely on you to deliver — and to show them the way — through thick and through thin."
      }
    };

    let currentQuestionIdx = 0;
    let scores = { Trailblazer: 0, Driver: 0, Connector: 0, Anchor: 0 };

    function switchScreen(screenId) {
      document.querySelectorAll('.trafera-quiz-scope .screen').forEach(el => el.classList.remove('active'));
      const target = document.getElementById(screenId);
      if (target) target.classList.add('active');
    }

    function handleStartQuiz() {
      currentQuestionIdx = 0;
      scores = { Trailblazer: 0, Driver: 0, Connector: 0, Anchor: 0 };
      switchScreen('screen-quiz');
      renderQuestion();
    }

    function renderQuestion() {
      const q = quizQuestions[currentQuestionIdx];
      const total = quizQuestions.length;

      document.getElementById('progress-question-num').innerText = `Question ${currentQuestionIdx + 1} of ${total}`;
      const percent = Math.round(((currentQuestionIdx + 1) / total) * 100);
      document.getElementById('progress-percent').innerText = `${percent}%`;
      document.getElementById('progress-indicator').style.width = `${percent}%`;

      document.getElementById('quiz-question-title').innerText = q.question;

      const container = document.getElementById('options-container');
      container.innerHTML = '';
      const letters = ['A', 'B', 'C', 'D', 'E'];

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('div');
        btn.className = 'option-item';
        btn.innerHTML = `
          <div class="option-badge">${letters[idx] || (idx + 1)}</div>
          <span style="flex:1;">${opt.text}</span>
        `;
        btn.addEventListener('click', () => {
          btn.classList.add('selected');
          handleSelectOption(opt.type);
        });
        container.appendChild(btn);
      });
    }

    function handleSelectOption(rawType) {
      if (rawType === 'trailblazer') scores.Trailblazer++;
      else if (rawType === 'driver') scores.Driver++;
      else if (rawType === 'cheerleader') scores.Connector++;
      else if (rawType === 'anchor' || rawType === 'compass') scores.Anchor++;

      setTimeout(() => {
        currentQuestionIdx++;
        if (currentQuestionIdx < quizQuestions.length) {
          renderQuestion();
        } else {
          showFinalResults();
        }
      }, 190);
    }

    function showFinalResults() {
      const order = ['Trailblazer', 'Driver', 'Connector', 'Anchor'];
      let winner = 'Trailblazer';
      let maxScore = -1;

      order.forEach(type => {
        if (scores[type] > maxScore) {
          maxScore = scores[type];
          winner = type;
        }
      });

      const data = resultsCatalog[winner];

      const imgEl = document.getElementById('result-img');
      imgEl.src = HUBSPOT_IMAGE_URLS[winner];
      imgEl.alt = data.title;

      document.getElementById('result-type-title').innerText = data.title;
      document.getElementById('result-type-desc').innerText = data.description;
      document.getElementById('result-value-name').innerText = data.values;

      renderHubSpotForm(winner);

      const breakdownGrid = document.getElementById('breakdown-grid');
      breakdownGrid.innerHTML = '';
      const totalAnswers = quizQuestions.length;

      order.forEach(type => {
        const count = scores[type];
        const pct = Math.round((count / totalAnswers) * 100);
        const pill = document.createElement('div');
        pill.className = `breakdown-pill ${type === winner ? 'lead' : ''}`;
        pill.innerHTML = `<span>${type}</span><span>${pct}%</span>`;
        breakdownGrid.appendChild(pill);
      });

      switchScreen('screen-result');
    }

    function handleRetakeQuiz() {
      const container = document.getElementById('hubspot-form-container');
      if (container) container.innerHTML = '';
      switchScreen('screen-start');
    }
  </script>
</div>

