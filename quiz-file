    const HUBSPOT_IMAGE_URLS = {
      Trailblazer: "https://connect.trafera.com/hubfs/For%20Web/teammate-type-trailblazer.png",
      Driver: "https://connect.trafera.com/hubfs/For%20Web/teammate-type-driver.png",
